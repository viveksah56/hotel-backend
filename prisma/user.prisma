enum Role {
  USER
  ADMIN
}


model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  role          Role     @default(USER)
  avatar        String?
  isVerified    Boolean  @default(false)

  lastLogin     DateTime?
  loginAttempts Int      @default(0)
  refreshToken  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}